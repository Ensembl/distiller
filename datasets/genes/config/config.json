{
    "info": {
        "id": "gene_view",
        "name": "Gene dataset",
        "source": "genes",
        "url_name": "genes",
        "include_remaining_columns": true
    },
    "filters": [
        {
            "id": "species_scientific_name",
            "target_column": "slice_region_assembly_organism_scientific_name",
            "label": "slice_region_assembly_organism_scientific_name",
            "title": "Species",
            "type": "fixed_list"
        },
        {
            "id": "genome",
            "target_column": "genome_uuid",
            "label": "concat(slice_region_assembly_organism_scientific_name, ' - ', slice_region_assembly_accession_id)",
            "title": "Genome",
            "type": "fixed_list"
        },
        {
            "id": "gene_symbol",
            "target_column": "symbol",
            "label": "Gene symbol",
            "title": "Gene symbol",
            "example": "PPP2R2A",
            "type": "match"
        },
        {
            "id": "stable_id",
            "target_column": "stable_id",
            "label": "Stable ID",
            "title": "Stable ID",
            "example": "ENSBTAG00070000112.1",
            "type": "match"
        },
        {
            "id": "gene_type",
            "target_column": "so_term",
            "label": "so_term",
            "title": "Gene type",
            "type": "fixed_list"
        },
        {
            "id": "taxon",
            "target_column": "slice_region_assembly_organism_species_taxon_id",
            "label": "Taxon ID",
            "title": "Taxon ID",
            "type": "match",
            "example": "9606"
        },
        {
            "id": "topology",
            "target_column": "slice_region_topology",
            "label": "slice_region_topology",
            "title": "Region topology",
            "type": "fixed_list"
        },
        {
            "id": "region_name",
            "target_column": "slice_region_name",
            "label": "Region name",
            "title": "Region name",
            "type": "match",
            "example": "X"
        },
        {
            "id": "strand",
            "target_column": "slice_strand_code",
            "label": "slice_strand_code",
            "title": "Strand",
            "type": "fixed_list"
        },
        {
            "id": "location",
            "target_column": "location",
            "label": "Location",
            "title": "Location",
            "example": "1:100-10000",
            "regex": "(?P<region>[^:]+):(?P<start>\\d+)-(?P<end>\\d+)",
            "type": "regex",
            "extras": {
                "fields": [
                    {
                        "column": "slice_region_name",
                        "regex_name": "region",
                        "match": "="
                    },
                    {
                        "column": "slice_location_end",
                        "regex_name": "start",
                        "match": ">="
                    },
                    {
                        "column": "slice_location_start",
                        "regex_name": "end",
                        "match": "<="
                    }
                ]
            }
        }
    ],
    "filter_groups": [
        {
            "group_id": "genomes",
            "group_label": "Genomes",
            "filters": [
                {
                    "id": "species_scientific_name"
                },
                {
                    "id": "genome"
                },
                {
                    "id": "taxon"
                }
            ]
        },
        {
            "group_id": "filters",
            "group_label": "Filters",
            "filters": [
                {
                    "id": "gene_type"
                },
                {
                    "id": "gene_symbol"
                },
                {
                    "id": "stable_id"
                },
                {
                    "id": "region_name"
                },
                {
                    "id": "topology"
                },
                {
                    "id": "location"
                },
                {
                    "id": "strand"
                }
            ]
        }
    ],
    "columns": [
        {
            "name": "symbol"
        },
        {
            "name": "name"
        },
        {
            "name": "gen_alt_symbols",
            "sortable": false,
            "label": "Alternative Symbols",
            "type": "string",
            "delimiter": ","
        },
        {
            "name": "metadata_name_url",
            "sortable": false,
            "label": "Metadata Details",
            "type": "link",
            "url": "{}"
        },
        {
            "name": "metadata_name_source_url",
            "sortable": false,
            "label": "Metadata Source",
            "type": "link",
            "url": "{}"
        },
        {
            "name": "alternative_symbols",
            "hidden": true
        }
    ]
}
