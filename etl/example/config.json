{
    "filters":[
        {
            "id":"id",
            "target_column":"id",
            "label":"ID",
            "title":"ID",
            "type" : "select",
            "match" : "exact"
        },
        {
            "id":"class",
            "target_column":"class",
            "label":"Class",
            "title":"Class",
            "type" : "select_list",
            "filter_labels":"lower(class)"
        },
        {
            "id":"location",
            "target_column":"location",
            "label":"Location",
            "title":"Location",
            "example":"1:100-10000",
            "regex":"(?P<region>[^:]+):(?P<start>\\d+)-(?P<end>\\d+)",
            "type":"regex",
            "extras": {
                "fields":[
                    {
                        "column":"region",
                        "regex_name":"region",
                        "match":"="
                    },
                    {
                        "column":"start",
                        "regex_name":"start",
                        "match":">="
	               },
	               {
                        "column":"stop",
                        "regex_name":"end",
                        "match":"<="
	               }
                ]
            }
        }
    ],
    "views":[
        {
            "id" : "test_view",
            "name":"Test data set",
            "source":"test",
            "url_name":"test",
            "include_remaining_columns" : true,
            "filter_groups" : [
                {
                    "group_id": "default",
                    "group_label": "Filters",
                    "filters":[
                        { "id" : "id" },
                        { "id" : "class" },
                        { "id": "location"}
                    ]
                }
            ],
              "columns":[
                  { "name": "id", "enabled":true },
                  { "name": "class" },
                  { "name": "stop" }
            ]
        }
    ],
    "columns":{
        "test_view":{
            "id":{
                "sortable": false,
                "label" : "ID",
                "type":"link",
                "url":"https://www.domain.com/ID/{}"
            },
            "gen_measurement": {
                "label":"Measurement",
                "sortable": false
            },
            "measurement": {
                "hidden": true
            },
            "unit": {
                "hidden": true
            }
        }
    }
}
