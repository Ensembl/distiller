{ 
  "compilerOptions": {
    "target": "ES2025",
    "lib": ["ES2025", "DOM"],
    "types": ["node"],
    "moduleResolution": "bundler", 
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true
  },
  "exclude": ["node_modules", "dist"]
}
